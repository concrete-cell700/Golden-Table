      "title": "🔀 Хаос",
      "scripts": [
        {
          "name": "Тасовка кнопок (цикл)",
          "description": "Кнопки постоянно перемешиваются — названия и действия едут вместе. Остановить: clearInterval(window.__btnShuffleLoop);location.reload()",
          "code": "(function(){if(window.__btnShuffleLoop)clearInterval(window.__btnShuffleLoop);function s(){var b=Array.from(document.querySelectorAll('button')).filter(function(x){return !x.closest('#__dt_panel')&&x.id!=='__dt_btn'});if(b.length<2)return;var o=b.map(function(x){return{html:x.innerHTML,onclick:x.onclick}});var ord=b.map(function(_,i){return i});for(var i=ord.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=ord[i];ord[i]=ord[j];ord[j]=t}b.forEach(function(x,i){var d=o[ord[i]];x.innerHTML=d.html;x.onclick=d.onclick})}s();window.__btnShuffleLoop=setInterval(s,2000);alert('🔁 Кнопки тасуются каждые 2 секунды')})();"
