          "code": "(function(){if(window.__balGuard)return;window.__balGuard=true;var orig=localStorage.setItem.bind(localStorage);localStorage.setItem=function(k,v){if(k==='zolotoy_stol_balance'){var cur=parseFloat(localStorage.getItem(k)||0);var nw=parseFloat(v);if(nw<cur)v=String(cur)}return orig(k,v)}})();alert('Баланс защищён от уменьшения')"
