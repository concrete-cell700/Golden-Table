          "name": "Рандомный редизайн",
          "description": "Полностью меняет цвета, шрифты, фон и размеры всех элементов",
          "code": "(function(){var c=['#ff006e','#8338ec','#3a86ff','#06ffa5','#ffbe0b','#fb5607','#8ecae6','#e63946'];var f=['Georgia,serif','Arial','Courier New','Impact','Comic Sans MS'];var r=function(a){return a[Math.floor(Math.random()*a.length)]};document.querySelectorAll('*').forEach(function(e){if(e.closest('#__dt_panel')||e.id==='__dt_btn')return;e.style.color=r(c);e.style.fontFamily=r(f);e.style.fontSize=Math.floor(Math.random()*15+11)+'px';e.style.textShadow='0 0 10px '+r(c);if(e.tagName==='BUTTON'||e.classList.contains('table-card')){e.style.background=r(c);e.style.color='#fff'}});document.body.style.background='url(https://picsum.photos/1600/1200?random='+Date.now()+') center/cover fixed'})();"
        },
        {
          "name": "Всё становится ДЕПНУТЬ",
          "description": "Заменяет все тексты и иконки на слово ДЕПНУТЬ",
          "code": "(function(){var W='ДЕПНУТЬ';function f(n){if(n.nodeType===3){if(n.nodeValue.trim())n.nodeValue=W}else if(n.nodeType===1){if(n.closest('#__dt_panel')||n.id==='__dt_btn'||n.tagName==='SCRIPT'||n.tagName==='STYLE')return;for(var i=0;i<n.childNodes.length;i++)f(n.childNodes[i])}}f(document.body);document.title=W})();"
        },
        {
          "name": "Цикл ДЕПНУТЬ",
          "description": "Каждые 200мс проверяет — если что-то не ДЕПНУТЬ, делает ДЕПНУТЬ",
          "code": "(function(){var W='ДЕПНУТЬ';if(window.__depnutLoop)clearInterval(window.__depnutLoop);function f(n){if(n.nodeType===3){if(n.nodeValue.trim()&&n.nodeValue.trim()!==W)n.nodeValue=W}else if(n.nodeType===1){if(n.closest('#__dt_panel')||n.id==='__dt_btn'||n.tagName==='SCRIPT'||n.tagName==='STYLE')return;for(var i=0;i<n.childNodes.length;i++)f(n.childNodes[i])}}function run(){try{f(document.body);if(document.title!==W)document.title=W}catch(e){}}run();window.__depnutLoop=setInterval(run,200)})();"
